// PINTURA MONTE FUJI

void setup() {
  // Configuración del lienzo
  size(760, 650);
  noLoop(); 
}

void draw() {
  // 1. SECCIÓN: CIELO 
  
  for (int y = 0; y < 360; y++) {
    float inter = map(y, 0, 360, 0, 1);
    color c = lerpColor(color(10, 78, 143), color(42, 132, 200), inter);
    stroke(c);
    line(0, y, width, y);
  }
  noStroke();

  // 2. SECCIÓN: MONTAÑA
  
  // Base de la montaña 
  fill(83, 52, 112); 
  triangle(150, 360, 380, 160, 610, 360); 

  // Nieve en la cima 
  fill(255, 255, 255); 
  beginShape();
  vertex(380, 160); 
  
  vertex(400, 185); 
  vertex(390, 195);
  vertex(425, 230); 
  vertex(410, 240);
  vertex(455, 280); 
  vertex(440, 290);
  vertex(490, 335); 
  vertex(475, 345);
  vertex(510, 360); 
  
  vertex(250, 360); 
  
  vertex(285, 325);
  vertex(270, 315);
  vertex(315, 270); 
  vertex(300, 260);
  vertex(345, 215); 
  vertex(335, 205);
  vertex(365, 175);
  endShape(CLOSE);

  // 3. SECCIÓN: COLINAS 

  
  // Capa de colinas verdes oscuras 
  fill(20, 76, 33); 
  rect(0, 345, width, 70); 

  // Función de casas 
  dibujarCasa(70, 375, 40, 40, color(193, 125, 56), color(156, 97, 48));   
  dibujarCasa(120, 365, 55, 50, color(45, 76, 102), color(156, 97, 48));    
  dibujarCasa(190, 355, 65, 60, color(31, 62, 83), color(156, 97, 48));     
  dibujarCasa(300, 345, 85, 70, color(83, 69, 110), color(156, 97, 48));    
  dibujarCasa(480, 370, 75, 50, color(184, 145, 56), color(156, 97, 48));  
  dibujarCasa(590, 380, 60, 40, color(54, 78, 108), color(156, 97, 48));    

 
  // 4. SECCIÓN: LAGO 
 
  for (int y = 420; y < height; y++) {
    float inter = map(y, 420, height, 0, 1);
    color c = lerpColor(color(21, 96, 154), color(5, 31, 50), inter);
    stroke(c);
    line(0, y, width, y);
  }
  noStroke();

  // 5. SECCIÓN: ÁRBOL DE CEREZO Y FLORES 
  
  // Ramas principales del cerezo 
  stroke(28, 18, 10); 
  noFill();

  strokeWeight(15);
  beginShape();
  vertex(780, 30);
  bezierVertex(700, 100, 650, 250, 630, 420);
  endShape();

  strokeWeight(8);
  beginShape();
  vertex(750, 100);
  bezierVertex(650, 180, 620, 250, 590, 380);
  endShape();

  noStroke();

  // --- B. Flores de cerezo ---
  dibujarRacimoFlores(720, 150, 250, 1500); 
  dibujarRacimoFlores(630, 380, 220, 1200); 
  dibujarRacimoFlores(760, 450, 180, 800);  
  dibujarRacimoFlores(690, 100, 150, 600);  

  // 6. SECCIÓN: DETALLES 
  
  fill(255, 255, 255, 153); 
  textSize(16);
  PFont fuenteFirma = createFont("Georgia", 16);
  textFont(fuenteFirma);
  text("AC", width - 60, height - 15);
}

// SECCIÓN DE CADA CASA 

void dibujarCasa(float x, float y, float w, float h, int colorPared, int colorTecho) {
  noStroke();
  
  // Sombra suave bajo el techo
  fill(0, 0, 0, 64);
  rect(x - 3, y - 10, w + 6, 14);
  
  // Techo de la casa
  fill(colorTecho);
  rect(x - 4, y - 11, w + 8, 13);
  
  // Pared principal
  fill(colorPared);
  rect(x, y, w, h);
  
  // Ventanas iluminadas
  fill(255, 219, 88);
  int numVentanasW = int(w / 14);
  int numVentanasH = int(h / 18);
  for(int i = 1; i <= numVentanasW; i++) {
    for(int j = 1; j <= numVentanasH; j++) {
      rect(x + (i * 12) - 6, y + (j * 16) - 8, 6, 7);
    }
  }
}

// SECCCIÓN DE RACIMOS DE FLORES DE CEREZO

void dibujarRacimoFlores(float x, float y, float radioMax, int densidad) {
  for (int i = 0; i < densidad; i++) {
    float angulo = random(TWO_PI);
    float radio = pow(random(1.0), 2) * radioMax; 
    
    float px = x + cos(angulo) * radio;
    float py = y + sin(angulo) * radio;
    float tamano = random(3, 7); 
    
    float alphaVal = random(100, 255);
    fill(255, random(160, 200), random(190, 240), alphaVal);
    
    ellipse(px, py, tamano, tamano); 
  }
}



